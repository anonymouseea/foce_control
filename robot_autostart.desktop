[Desktop Entry]
Type=Application
# 这里的路径必须指向你在远程控制器上存放 autostart_robot.sh 的实际绝对路径
# 假设远程用户名也是 szl, 放在 robot 目录下。如果不是，请务必修改下面这一行！
# 格式: Exec=/bin/bash /home/远程用户名/robot/autostart_robot.sh
Exec=/bin/bash /home/szl/robot/autostart_robot.sh
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
Name=RobotControlAutostart
Comment=Auto start robot control script
Terminal=false
